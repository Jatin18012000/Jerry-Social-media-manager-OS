# Jatin Social Media OS — example environment.
# Copy to .env.local and fill in. NEVER commit .env.local (§41).

# §64: FOUNDATION (local, free) or PRODUCTION (cloud, paid).
MODE=FOUNDATION

# SQLite database file. Local-first (§34).
DATABASE_URL=./data/os.db

# Dashboard authentication (§41). BOTH are required — the app refuses to
# serve anything without them, because it binds to 0.0.0.0 so an iPad can
# reach it, which means every device on the network can reach it too.
# Generate the secret with: openssl rand -hex 32
SESSION_SECRET=
APP_PASSPHRASE=

# --- Ports / adapters (§35). Empty = adapter disabled. ---

# AI provider for mechanical work (dedupe, classification, relevance scoring).
# Local Ollama, free (§34). Leave empty to disable.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Content generation. V1 = MANUAL (brief out, paste in).
# Switch to ANTHROPIC or GEMINI only when a budget is authorised (§32, §36).
AI_GENERATION_MODE=MANUAL
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Publishing. V1 = MANUAL until platform access clears (§25).
PUBLISHER_MODE=MANUAL
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Analytics ingestion. V1 = OCR (§34 local OCR) with MANUAL fallback.
ANALYTICS_MODE=OCR
