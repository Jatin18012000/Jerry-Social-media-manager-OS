# Jatin Social Media OS — example environment.
# Copy to .env.local and fill in. NEVER commit .env.local (§41).

# §64: FOUNDATION (local, free) or PRODUCTION (cloud, paid).
MODE=FOUNDATION

# SQLite database file. Local-first (§34).
DATABASE_URL=./data/os.db

# Dashboard authentication (§41). BOTH are required — the app refuses to
# serve anything without them, because it binds to 0.0.0.0 so an iPad can
# reach it, which means every device on the network can reach it too.
# Generate the secret with: openssl rand -hex 32
SESSION_SECRET=
APP_PASSPHRASE=

# --- Ports / adapters (§35). Empty = adapter disabled. ---

# Local model for mechanical work: pillar, relevance and language
# classification. Free, offline, optional (§34, §36).
#
# Leaving OLLAMA_MODEL empty disables it entirely and the system runs on its
# deterministic heuristics — that is a supported configuration, not a
# degraded one.
#
# Set OLLAMA_MODEL to a tag `ollama list` actually reports on your machine.
# It is deliberately not defaulted: §7.1 forbids assuming a model exists.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Content generation. V1 = MANUAL (brief out, paste in).
# Switch to ANTHROPIC or GEMINI only when a budget is authorised (§32, §36).
AI_GENERATION_MODE=MANUAL
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Publishing. V1 = MANUAL until platform access clears (§25).
PUBLISHER_MODE=MANUAL
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Analytics ingestion. V1 = OCR (§34 local OCR) with MANUAL fallback.
ANALYTICS_MODE=OCR

# Obsidian export (optional). Absolute path to a vault on this machine.
#
# Leave empty and nothing is written. The vault is a one-way, human-readable
# projection of the database — there is no importer, so the database stays the
# system of record by construction rather than by promise.
#
# Notes go into "Social Media OS/" inside the vault. Anything you write below
# the generated markers in a note is preserved on every re-export.
OBSIDIAN_VAULT_PATH=
